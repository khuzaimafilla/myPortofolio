---
import { portfolioData } from '@data/portfolioData';
---

<header class="fixed top-0 left-0 w-full z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-3">
    <nav class="flex items-center justify-between h-14 px-6 rounded-full bg-slate-900/80 backdrop-blur-md border border-white/10 shadow-lg shadow-black/20">
      <!-- Brand Logo -->
      <a href="#hero" class="group flex items-center gap-2 text-slate-100 font-heading font-bold text-base sm:text-lg tracking-tight">
        <span class="w-2.5 h-2.5 rounded-full bg-accent-gold group-hover:scale-125 transition-transform"></span>
        <span class="bg-gradient-to-r from-white via-slate-200 to-accent-gold bg-clip-text text-transparent">
          {portfolioData.name.split(' ')[0]} <span class="text-accent-gold font-light">{portfolioData.name.split(' ')[1]}</span>
        </span>
      </a>

      <!-- Desktop Navigation Links -->
      <ul class="hidden md:flex items-center gap-8 text-xs font-medium text-slate-300">
        <li>
          <a href="#hero" class="hover:text-accent-gold transition-colors duration-200 py-1">Home</a>
        </li>
        <li>
          <a href="#about" class="hover:text-accent-gold transition-colors duration-200 py-1">About</a>
        </li>
        <li>
          <a href="#skills" class="hover:text-accent-gold transition-colors duration-200 py-1">Skills</a>
        </li>
        <li>
          <a href="#projects" class="hover:text-accent-gold transition-colors duration-200 py-1">Projects</a>
        </li>
        <li>
          <a href="#contact" class="hover:text-accent-gold transition-colors duration-200 py-1">Contact</a>
        </li>
      </ul>

      <!-- Right Action: Cmd + K trigger button & Mobile trigger -->
      <div class="flex items-center gap-3">
        <button 
          id="cmd-k-btn"
          onclick="document.dispatchEvent(new KeyboardEvent('keydown', {'key': 'k', 'metaKey': true}))"
          class="hidden sm:inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 border border-white/10 hover:border-accent-gold/50 text-slate-300 hover:text-white text-xs transition-all duration-200"
          title="Open Command Palette"
        >
          <svg class="w-3.5 h-3.5 text-accent-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <span class="text-[11px] font-mono text-slate-400">Search</span>
          <kbd className="px-1.5 py-0.5 text-[10px] font-semibold text-slate-400 bg-slate-800 rounded border border-white/10">⌘K</kbd>
        </button>

        <a
          href={portfolioData.cvUrl}
          download
          class="px-4 py-1.5 rounded-full bg-gradient-to-r from-accent-red to-accent-red-dark hover:from-accent-red-dark hover:to-accent-red-deep text-white text-xs font-semibold shadow-md shadow-accent-red/20 transition-all hover:scale-[1.03]"
        >
          CV
        </a>
      </div>
    </nav>
  </div>
</header>
