---
import { portfolioData } from '@data/portfolioData';
---

<footer class="py-12 border-t border-white/10 relative px-4 sm:px-6 lg:px-8 bg-slate-950">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6 text-xs text-slate-400">
    
    <!-- Left: Brand & Copyright -->
    <div class="flex items-center gap-3">
      <span class="font-heading font-bold text-white text-sm">{portfolioData.name}</span>
      <span class="w-1.5 h-1.5 rounded-full bg-slate-700"></span>
      <span>© {new Date().getFullYear()} All Rights Reserved.</span>
    </div>

    <!-- Tech Stack Badge -->
    <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-[11px]">
      <span class="text-slate-400">Engineered with</span>
      <span class="text-accent-gold font-medium">Astro</span>
      <span>•</span>
      <span class="text-sky-400 font-medium">Tailwind CSS</span>
      <span>•</span>
      <span class="text-accent-red font-medium">Framer Motion</span>
    </div>

    <!-- Right: Back to Top -->
    <a
      href="#hero"
      class="hover:text-accent-gold transition-colors flex items-center gap-1 font-heading font-semibold"
    >
      <span>Back to top</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
      </svg>
    </a>

  </div>
</footer>
