---
import { portfolioData } from '@data/portfolioData';
---

<section id="skills" class="py-24 relative px-4 sm:px-6 lg:px-8 bg-slate-950/40">
  <div class="max-w-7xl mx-auto">
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center mb-16">
      <span class="text-xs font-heading font-semibold tracking-widest text-accent-gold uppercase mb-2">Technical Proficiency</span>
      <h2 class="font-heading font-bold text-3xl sm:text-4xl text-white tracking-tight">Skills & Capabilities</h2>
      <div class="w-12 h-1 bg-gradient-to-r from-accent-red to-accent-gold rounded-full mt-4"></div>
    </div>

    <!-- Skills Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {portfolioData.skills.map((skill) => (
        <div class="group relative bg-slate-900/60 backdrop-blur-md border border-white/10 hover:border-accent-gold/40 rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1 shadow-lg hover:shadow-accent-gold/5">
          <div class="flex items-center justify-between mb-4">
            <span class="px-2.5 py-1 rounded-md text-[10px] font-semibold tracking-wide uppercase bg-white/5 border border-white/10 text-slate-300">
              {skill.category}
            </span>
            <span class="font-heading font-bold text-sm text-accent-gold">
              {skill.level}%
            </span>
          </div>

          <h3 class="font-heading font-bold text-lg text-white group-hover:text-accent-gold transition-colors mb-2">
            {skill.name}
          </h3>

          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            {skill.description}
          </p>

          <!-- Level Bar -->
          <div class="w-full h-1.5 bg-slate-800 rounded-full overflow-hidden">
            <div
              class="h-full bg-gradient-to-r from-accent-red via-accent-gold to-amber-300 rounded-full transition-all duration-1000"
              style={`width: ${skill.level}%`}
            ></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
