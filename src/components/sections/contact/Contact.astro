---
import { portfolioData } from '@data/portfolioData';
---

<section id="contact" class="py-24 relative px-4 sm:px-6 lg:px-8 bg-slate-950/60">
  <div class="max-w-4xl mx-auto text-center">
    <!-- Section Header -->
    <span class="text-xs font-heading font-semibold tracking-widest text-accent-gold uppercase mb-2 block">Get In Touch</span>
    <h2 class="font-heading font-bold text-3xl sm:text-5xl text-white tracking-tight mb-4">Let's Build Something Exceptional</h2>
    <p class="text-slate-400 text-base max-w-xl mx-auto mb-10 font-sans">
      Whether you have an upcoming project, engineering role, or design inquiry, feel free to reach out directly through any platform below.
    </p>

    <!-- Contact Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- LinkedIn -->
      <a
        href={portfolioData.contact.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="group p-6 rounded-2xl bg-slate-900/80 border border-white/10 hover:border-blue-500/50 hover:bg-blue-950/20 transition-all duration-300 flex flex-col items-center text-center shadow-lg"
      >
        <div class="w-12 h-12 rounded-xl bg-blue-600/10 border border-blue-500/20 flex items-center justify-center text-blue-400 group-hover:scale-110 transition-transform mb-3">
          <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
          </svg>
        </div>
        <span class="font-heading font-bold text-sm text-white group-hover:text-blue-400 transition-colors">LinkedIn</span>
        <span class="text-xs text-slate-400 mt-1">Connect Professionally</span>
      </a>

      <!-- Instagram -->
      <a
        href={portfolioData.contact.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="group p-6 rounded-2xl bg-slate-900/80 border border-white/10 hover:border-pink-500/50 hover:bg-pink-950/20 transition-all duration-300 flex flex-col items-center text-center shadow-lg"
      >
        <div class="w-12 h-12 rounded-xl bg-pink-600/10 border border-pink-500/20 flex items-center justify-center text-pink-400 group-hover:scale-110 transition-transform mb-3">
          <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </div>
        <span class="font-heading font-bold text-sm text-white group-hover:text-pink-400 transition-colors">Instagram</span>
        <span class="text-xs text-slate-400 mt-1">Follow Updates</span>
      </a>

      <!-- Email -->
      <a
        href={portfolioData.contact.email}
        class="group p-6 rounded-2xl bg-slate-900/80 border border-white/10 hover:border-amber-500/50 hover:bg-amber-950/20 transition-all duration-300 flex flex-col items-center text-center shadow-lg"
      >
        <div class="w-12 h-12 rounded-xl bg-amber-600/10 border border-amber-500/20 flex items-center justify-center text-amber-400 group-hover:scale-110 transition-transform mb-3">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
        </div>
        <span class="font-heading font-bold text-sm text-white group-hover:text-amber-400 transition-colors">Email</span>
        <span class="text-xs text-slate-400 mt-1">Direct Message</span>
      </a>

      <!-- WhatsApp -->
      <a
        href={portfolioData.contact.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="group p-6 rounded-2xl bg-slate-900/80 border border-white/10 hover:border-emerald-500/50 hover:bg-emerald-950/20 transition-all duration-300 flex flex-col items-center text-center shadow-lg"
      >
        <div class="w-12 h-12 rounded-xl bg-emerald-600/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 group-hover:scale-110 transition-transform mb-3">
          <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-1.156 4.22 4.288-1.124z"/>
          </svg>
        </div>
        <span class="font-heading font-bold text-sm text-white group-hover:text-emerald-400 transition-colors">WhatsApp</span>
        <span class="text-xs text-slate-400 mt-1">Instant Chat</span>
      </a>
    </div>
  </div>
</section>
